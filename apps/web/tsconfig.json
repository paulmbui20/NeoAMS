{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "inlineSources": false,
    "strict": true,
    "moduleResolution": "bundler"
  }
}

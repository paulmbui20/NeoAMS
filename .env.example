# NeoAMS — environment.
#
# Copy this file to `.env` and edit it. Nothing here has a safe default in
# production: the secret and the public address must be set.

# --- the API ---------------------------------------------------------------

# Where the SQLite file lives. In Docker this is inside the volume.
DB_FILE_NAME=neoams.sqlite

# The secret that signs the session cookies. At least 32 random characters.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=your-32-characters-secret-key-change-this-in-prod

# The address the API believes it is reached at.
BETTER_AUTH_URL=http://localhost:3000

# The address of the web app. Writes from any other origin are refused.
FRONTEND_URL=http://localhost:5173

PORT=3000

# True when the API sits behind a reverse proxy (Caddy, nginx), so the
# client addresses in the logs and the rate limiter are the real ones.
TRUST_PROXY=false

# How long an unpaid online booking holds its room, in minutes.
BOOKING_HOLD_MINUTES=120

# How long a booking waits for its payment proof to be reviewed, in hours.
PROOF_HOLD_HOURS=24

# Optional. When set, POST /setup demands this exact token, so an exposed
# fresh installation cannot be claimed by whoever finds it first.
SETUP_TOKEN=

# Where uploaded images are written.
UPLOAD_DIR=./uploads

# The largest image that may be uploaded, in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880

# The sign-in rate limit. It is on in production and should stay on.
# One address may make this many sign-in attempts a minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SIGN_IN_MAX=10

# --- production (docker compose) -------------------------------------------

# The address the whole system is reached at. Used by both services.
PUBLIC_URL=http://localhost:3000

# The host name Caddy answers for. `localhost` for a local trial.
DOMAIN=localhost

# Where Caddy sends the certificate notices.
ACME_EMAIL=

# Which Caddy configuration to use. Use ./deploy/Caddyfile.local for a
# trial on this machine: it signs its own certificate.
CADDYFILE=./deploy/Caddyfile

# The web app talks to the API on the same origin, so Caddy sends the API
# paths to the API container and everything else to the web container.
#
#   docker compose up -d
#
# Set DOMAIN to your host name (and ACME_EMAIL for the certificate notices).

{
	# The address that Let's Encrypt sends the expiry notices to.
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	# The API, its authentication endpoints, the uploaded images and the
	# interactive API reference.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /uploads/* {
		reverse_proxy api:3000
	}
	handle /reference* {
		reverse_proxy api:3000
	}

	# Everything else is the SvelteKit app.
	handle {
		reverse_proxy web:3000
	}
}
